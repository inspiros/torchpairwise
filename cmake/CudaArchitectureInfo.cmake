# Report only targets that can be resolved from the actual build controls.
# Runtime hardware and CUDA attribute enum values are not build metadata.
function(torchpairwise_cuda_arch_targets output flags architectures)
  set(_targets)
  if("${flags}" MATCHES "(^|[ ;])(-arch|--gpu-architecture|-code|--gpu-code)(=|[ ;])")
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCHALL "(^|[=, ;])code[ ]*=[ ]*(\\[[^]]*\\]|[^, ;]+)"
         _codes "${flags}")
  foreach(_code IN LISTS _codes)
    string(REGEX REPLACE "^.*code[ ]*=[ ]*" "" _items "${_code}")
    string(REGEX REPLACE "^\\[|\\]$" "" _items "${_items}")
    string(REPLACE "," ";" _items "${_items}")
    foreach(_item IN LISTS _items)
      string(STRIP "${_item}" _item)
      if(NOT _item MATCHES "^(sm|compute)_[0-9]+[a-z]?$")
        set(${output} "" PARENT_SCOPE)
        return()
      endif()
      list(APPEND _targets "${_item}")
    endforeach()
  endforeach()
  foreach(_arch IN LISTS architectures)
    if(_arch MATCHES "^([0-9]+[a-z]?)(-real|-virtual)?$")
      set(_number "${CMAKE_MATCH_1}")
      set(_kind "${CMAKE_MATCH_2}")
      if(NOT _kind STREQUAL "-virtual")
        list(APPEND _targets "sm_${_number}")
      endif()
      if(NOT _kind STREQUAL "-real")
        list(APPEND _targets "compute_${_number}")
      endif()
    elseif(_arch AND NOT _arch STREQUAL "OFF")
      # native/all/all-major depend on compiler/hardware detection. Unknown
      # is preferable to reporting only part of the compiled target list.
      set(${output} "" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _targets)
  list(SORT _targets)
  list(JOIN _targets " " _text)
  set(${output} "${_text}" PARENT_SCOPE)
endfunction()
