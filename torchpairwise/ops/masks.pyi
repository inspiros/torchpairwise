from typing import Any, Optional, Union
from torch import Tensor
from ._pairwise_operator import LazyPairwise

class PairMask:
    def __and__(self, other: Union["PairMask", LazyPairwise, Tensor]) -> "PairMask": ...
    def __rand__(self, other: Union[LazyPairwise, Tensor]) -> "PairMask": ...
    def __or__(self, other: Union["PairMask", LazyPairwise, Tensor]) -> "PairMask": ...
    def __ror__(self, other: Union[LazyPairwise, Tensor]) -> "PairMask": ...
    def __invert__(self) -> "PairMask": ...

def same_group(labels: Tensor, other: Optional[Tensor] = None) -> PairMask: ...
def different_group(labels: Tensor, other: Optional[Tensor] = None) -> PairMask: ...
def causal(offset: int = 0) -> PairMask: ...
def band(lower: int = 0, upper: int = 0) -> PairMask: ...
def diagonal() -> PairMask: ...
