    def ne(self, other: Any) -> "LazyPairwise": ...
    def __and__(self, other: Any) -> "LazyPairwise": ...
    def __or__(self, other: Any) -> "LazyPairwise": ...
    def logical_and(self, other: Any) -> "LazyPairwise": ...
    def logical_or(self, other: Any) -> "LazyPairwise": ...
    def clamp(self, min: Any = None, max: Any = None) -> "LazyPairwise": ...
