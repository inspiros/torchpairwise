    def tanh(self) -> "LazyPairwise": ...
    def sigmoid(self) -> "LazyPairwise": ...
    def abs(self) -> "LazyPairwise": ...
    def __abs__(self) -> "LazyPairwise": ...
    def logical_not(self) -> "LazyPairwise": ...
    def __invert__(self) -> "LazyPairwise": ...
    def __truediv__(self, other: Any) -> "LazyPairwise": ...
    def __rtruediv__(self, other: Any) -> "LazyPairwise": ...
    def __pow__(self, other: Any) -> "LazyPairwise": ...
