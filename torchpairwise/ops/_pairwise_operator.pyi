_ScalarOperator = LazyPairwise

class PairwiseOperator(_ScalarOperator):
    def __init__(self, x1: Collection, x2: Optional[Collection] = None, *, metric: str = 'euclidean', chunk_size: Optional[int] = None, **metric_kwargs: Any) -> None: ...
    @property
    def shape(self) -> torch.Size: ...
    @property
    def dtype(self) -> torch.dtype: ...
    @property
    def device(self) -> torch.device: ...
    @property
    def T(self) -> "PairwiseOperator": ...
