from typing import Optional, Union
import torch
from torch import Tensor
from ._pairwise_operator import Dimensions, LazyPairwise

class ResidualOperator:
    def __init__(self, x1: Tensor, x2: Optional[Tensor] = None, *, transform: str = 'identity', chunk_size: int = 128, feature_chunk_size: int = 128) -> None: ...
    @property
    def shape(self) -> torch.Size: ...
    @property
    def dtype(self) -> torch.dtype: ...
    @property
    def device(self) -> torch.device: ...
    def reduce(self, reduction: str = 'sum', dim: Dimensions = -1, *, correction: Optional[float] = None, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def sum(self, dim: Dimensions = -1, *, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def mean(self, dim: Dimensions = -1, *, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def min(self, dim: Dimensions = -1, *, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def max(self, dim: Dimensions = -1, *, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def prod(self, dim: Dimensions = -1, *, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def all(self, dim: Dimensions = -1, *, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def any(self, dim: Dimensions = -1, *, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def var(self, dim: Dimensions = -1, *, correction: float = 1, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def std(self, dim: Dimensions = -1, *, correction: float = 1, keepdim: bool = False) -> Union[LazyPairwise, Tensor]: ...
    def topk(self, k: int, dim: int = -1, largest: bool = True, sorted: bool = True) -> torch.return_types.topk: ...

def residual_operator(x1: Tensor, x2: Optional[Tensor] = None, *, transform: str = 'identity', chunk_size: int = 128, feature_chunk_size: int = 128) -> ResidualOperator: ...
