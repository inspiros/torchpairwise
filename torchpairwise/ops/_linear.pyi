from typing import Union, Sequence, Optional, overload
import torch
from torch import Tensor
from ._pairwise_operator import LazyPairwise

Factor = Union[int, float, Tensor]

class LinearOperator(LazyPairwise):
    def __init__(self, source: Union[Tensor, LazyPairwise], *, _kind: str = ..., _right: object = ...) -> None: ...
    @property
    def entrywise(self) -> bool: ...
    @property
    def shape(self) -> torch.Size: ...
    @property
    def dtype(self) -> torch.dtype: ...
    @property
    def device(self) -> torch.device: ...
    @property
    def T(self) -> LinearOperator: ...
    def centered(self, reference_mean: Optional[Tensor] = None) -> LinearOperator: ...
    def matmul(self, values: Tensor) -> Tensor: ...
    def to_dense(self) -> Tensor: ...
    @overload
    def __matmul__(self, other: LazyPairwise) -> LinearOperator: ...
    @overload
    def __matmul__(self, other: Tensor) -> Tensor: ...

def _as_linear(source: Union[Tensor, LazyPairwise]) -> LinearOperator: ...
def _block(blocks: Sequence[Sequence[Union[Tensor, LazyPairwise]]]) -> LinearOperator: ...
def _group_projection(labels: Tensor, *, like: Union[Tensor, LazyPairwise]) -> LinearOperator: ...
def _diagonal(values: Tensor) -> LinearOperator: ...
def _identity(reference: LazyPairwise) -> LinearOperator: ...
def _linear_binary(operation: str, left: object, right: object) -> LinearOperator: ...

def _softmax_solver_source(source: LazyPairwise, exclude_self: bool) -> LinearOperator: ...
