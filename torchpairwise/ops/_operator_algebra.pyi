from typing import Any
import torch
from ._pairwise_operator import _ScalarOperator

class ScalarExpression(_ScalarOperator):
    def __init__(self, operation: str, left: Any, right: Any = ...) -> None: ...
    @property
    def shape(self) -> torch.Size: ...
    @property
    def dtype(self) -> torch.dtype: ...
    @property
    def device(self) -> torch.device: ...
    @property
    def T(self) -> ScalarExpression: ...

def row_values(like: _ScalarOperator, tensor: torch.Tensor) -> ScalarExpression: ...
def column_values(like: _ScalarOperator, tensor: torch.Tensor) -> ScalarExpression: ...
def row_index(like: _ScalarOperator) -> ScalarExpression: ...
def column_index(like: _ScalarOperator) -> ScalarExpression: ...
